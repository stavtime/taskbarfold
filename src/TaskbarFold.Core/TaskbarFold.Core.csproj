<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>TaskbarFold.Core</RootNamespace>
    <AssemblyName>TaskbarFold.Core</AssemblyName>
    <!-- Hard rule: the domain layer never references a UI framework. -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <IsPublishable>false</IsPublishable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskbarFold.Tests" />
  </ItemGroup>

</Project>
