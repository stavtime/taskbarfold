<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette. Every key in Dark.xaml must have a counterpart here. -->

    <Color x:Key="SurfaceColor">#FAFAFC</Color>
    <Color x:Key="AccentColor">#2F6FE0</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F0F0F4" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#F2FAFAFC" />

    <SolidColorBrush x:Key="TextBrush" Color="#16161A" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F5F6B" />
    <SolidColorBrush x:Key="TextInvertedBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A84EA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2456B4" />

    <SolidColorBrush x:Key="BorderBrush" Color="#D8D8DF" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E8E8EE" />

    <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#22000000" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#552F6FE0" />

    <SolidColorBrush x:Key="DangerBrush" Color="#D14338" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B67A17" />

</ResourceDictionary>
