<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TaskbarFold.App</RootNamespace>
    <AssemblyName>TaskbarFold</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TaskbarFold.ico</ApplicationIcon>
    <StartupObject>TaskbarFold.App.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Publish profile: one self-contained file, no runtime prerequisite for the user. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Every click on a pinned group starts this executable, so its start-up time is paid
         every time. Measured for the whole signalling round trip: compressed without
         ReadyToRun 129 ms, uncompressed with ReadyToRun 70 ms (156 MB instead of 63 MB),
         and both together 388 ms. The two settings have to change as a pair. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is compiled as a Page so the custom Program.Main stays the entry point.
         The SDK-generated Main would construct an Application before the command line is
         inspected, which the group-signalling mode must not do. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <!-- Lets the named pipe be created with an explicit ACL. Without it the pipe would
         rely on the default descriptor, which is broader than this application needs. -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarFold.Core\TaskbarFold.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\TaskbarFold.ico" />
  </ItemGroup>

</Project>
